App(
    appid="fobworks_flipper",
    name="FOBworks for Flipper",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipper_fobscan_app",
    requires=["subghz"],
    cdefines=["FLIPPER_FAP_SLIM=1"],
    stack_size=4 * 1024,
    fap_category="Sub-GHz",
    fap_version=(1, 4),
    fap_description="v1.4 for official 1.4.3. Slim host FAP; catalog, Sec+, Scher-Khan, and Hitag2 live in embedded plugins.",
    sources=[
        "flipper_fobscan_app.c",
        "link/flipper_link.c",
        "link/flipper_link_dispatch.c",
        "link/flipper_link_proto.c",
        "protocol/flipper_capture.c",
        "protocol/flipper_chrysler.c",
        "protocol/flipper_decoders.c",
        "protocol/flipper_fiat.c",
        "protocol/flipper_ford.c",
        "protocol/flipper_gm.c",
        "protocol/flipper_honda.c",
        "protocol/flipper_keeloq.c",
        "protocol/flipper_kia.c",
        "protocol/flipper_library.c",
        "protocol/flipper_library_rules.c",
        "protocol/flipper_mazda.c",
        "protocol/flipper_oem_wire.c",
        "protocol/flipper_plugin.c",
        "protocol/flipper_psa.c",
        "protocol/flipper_radio_loader.c",
        "protocol/flipper_rollingpwn.c",
        "protocol/flipper_saved_check.c",
        "protocol/flipper_scratch.c",
        "protocol/flipper_subaru.c",
        "protocol/flipper_suzuki.c",
        "protocol/flipper_toyota.c",
        "protocol/flipper_tx_session.c",
        "protocol/flipper_vag.c",
        "protocol/flipper_vehicles_host.c",
        "protocol/flipper_vehrke.c",
        "scenes/flipper_scene_adv_settings.c",
        "scenes/flipper_scene_credits.c",
        "scenes/flipper_scene_fobback.c",
        "scenes/flipper_scene_fobcatch.c",
        "scenes/flipper_scene_fobclone.c",
        "scenes/flipper_scene_fobcrack.c",
        "scenes/flipper_scene_fobloq.c",
        "scenes/flipper_scene_fobprotos.c",
        "scenes/flipper_scene_fobpwn.c",
        "scenes/flipper_scene_fobscan.c",
        "scenes/flipper_scene_fobsweep.c",
        "scenes/flipper_scene_info.c",
        "scenes/flipper_scene_library.c",
        "scenes/flipper_scene_libscope.c",
        "scenes/flipper_scene_main_menu.c",
        "scenes/flipper_scene_rx_tools.c",
    ],
)

App(
    appid="fw_catalog",
    name="FOBworks catalog",
    apptype=FlipperAppType.PLUGIN,
    entry_point="fw_catalog_ep",
    requires=["fobworks_flipper"],
    fal_embedded=True,
    sources=[
        "plugins/fw_catalog.c",
        "protocol/flipper_vehicles.c",
    ],
)

App(
    appid="fw_force",
    name="FOBworks force extras",
    apptype=FlipperAppType.PLUGIN,
    entry_point="fw_force_ep",
    requires=["fobworks_flipper"],
    fal_embedded=True,
    sources=[
        "plugins/fw_force.c",
        "protocol/flipper_scher_khan.c",
        "protocol/flipper_secplus.c",
        "protocol/flipper_hitag2.c",
    ],
)
